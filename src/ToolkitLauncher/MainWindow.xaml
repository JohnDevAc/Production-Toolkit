<Window x:Class="ToolkitLauncher.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ToolkitLauncher" Title="Production Toolkit" Width="1120" Height="1040"
 MinWidth="640" MinHeight="480" Background="#F3F6F8" FontFamily="Segoe UI" FontSize="13"
 Icon="Assets/toolkit.ico" WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <Grid x:Name="MainLayout" Background="#F3F6F8" TextElement.Foreground="#1C2A3A">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="#172F3E" Padding="28,18">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Border Background="#244C5B" CornerRadius="11" Width="48" Height="48" Margin="0,0,16,0" VerticalAlignment="Top">
     <Viewbox Margin="10"><Canvas Width="32" Height="32">
      <Rectangle Width="12" Height="12" Fill="#B6E6DA" RadiusX="2" RadiusY="2"/>
      <Rectangle Canvas.Left="18" Width="12" Height="12" Fill="#73C8B3" RadiusX="2" RadiusY="2"/>
      <Rectangle Canvas.Top="18" Width="12" Height="12" Fill="#73C8B3" RadiusX="2" RadiusY="2"/>
      <Path Data="M18,29 L29,18 M20,18 L29,18 L29,27" Stroke="White" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
     </Canvas></Viewbox>
    </Border>
    <StackPanel Grid.Column="1" VerticalAlignment="Center">
     <TextBlock Text="Production Toolkit" Foreground="White" FontSize="26" FontWeight="SemiBold"/>
     <TextBlock Text="Install, update and launch your production apps." Foreground="#BDD0DA" Margin="0,5,12,0"/>
    </StackPanel>
    <Border Grid.Column="2" Background="#284553" CornerRadius="5" Padding="10,6" VerticalAlignment="Center">
     <TextBlock Text="WINDOWS x64" Foreground="#C4DAD9" FontSize="10" FontWeight="SemiBold"/>
    </Border>
   </Grid>
  </Border>
  <ScrollViewer x:Name="MainScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,18,24,16">
   <StackPanel>
    <Grid Margin="4,0,4,16">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
      <TextBlock Text="Your applications" FontSize="21" FontWeight="SemiBold"/>
      <TextBlock Text="{Binding Summary}" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/>
     </StackPanel>
     <Button Grid.Column="1" Content="{Binding RefreshText}" Click="RefreshClick" IsEnabled="{Binding CanRefresh}" VerticalAlignment="Center"/>
    </Grid>
    <ItemsControl x:Name="CardsControl" ItemsSource="{Binding Cards}" IsEnabled="{Binding DashboardEnabled}">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><local:CardGrid Columns="{Binding Columns}"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate><DataTemplate>
      <Border Background="{Binding Theme.Background}" BorderBrush="{Binding Theme.Border}" BorderThickness="1" CornerRadius="10" Padding="20" Margin="4,0,4,12">
       <Grid>
       <Grid Visibility="{Binding ShowDetails, Converter={StaticResource VisibleIf}}">
        <Grid.RowDefinitions>
         <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
         <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
         <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <Border Width="42" Height="42" Background="{Binding Theme.IconWell}" CornerRadius="8" Margin="0,0,12,0" VerticalAlignment="Top">
          <Image Source="{Binding Icon}" Width="36" Height="36" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="{Binding Name}"/>
         </Border>
         <StackPanel Grid.Column="1">
          <TextBlock Text="{Binding Subtitle}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="0,0,0,4"/>
          <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold"/>
         </StackPanel>
        </Grid>
        <TextBlock Grid.Row="1" Text="{Binding Description}" Foreground="{StaticResource Muted}" Margin="0,10,0,10" MinHeight="36" LineHeight="18"/>
        <Grid Grid.Row="2" Margin="0,0,0,10">
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <StackPanel Margin="0,0,12,0">
          <TextBlock Text="Installed version" FontSize="11" Foreground="{StaticResource Muted}"/>
          <TextBlock Text="{Binding InstalledText}" ToolTip="{Binding VersionToolTip}" FontWeight="SemiBold" Margin="0,4,0,0"/>
         </StackPanel>
         <Border Grid.Column="1" Background="#F0F4F6" Padding="9,5" CornerRadius="5" VerticalAlignment="Center" MaxWidth="185" ToolTip="{Binding StatusToolTip}">
          <TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}" FontSize="11" FontWeight="SemiBold"/>
         </Border>
        </Grid>
        <Border Grid.Row="3" Background="{Binding Theme.Panel}" BorderBrush="{Binding Theme.Border}" BorderThickness="1" CornerRadius="6" Padding="12">
         <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
           <TextBlock Text="Latest release" FontSize="11" Foreground="{StaticResource Muted}"/>
           <TextBlock Text="{Binding LatestText}" Margin="0,4,0,0" FontWeight="SemiBold"/>
          </StackPanel>
          <ComboBox Grid.Column="1" Width="132" ItemsSource="{Binding Channels}" SelectedItem="{Binding Channel}" IsEnabled="{Binding CanChoose}"
           AutomationProperties.Name="Release channel" ToolTip="Choose the release channel used for downloads and update checks."/>
         </Grid>
        </Border>
        <StackPanel Grid.Row="4" Margin="0,8,0,0">
         <TextBlock Text="{Binding PcAgentRuntimeText}" Foreground="{Binding PcAgentRuntimeColour}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5"
          Visibility="{Binding ShowPcAgentRuntime, Converter={StaticResource VisibleIf}}"/>
         <TextBlock Text="{Binding SetupNotice}" FontSize="11" Foreground="#94620F" Visibility="{Binding NeedsPcAgentSetup, Converter={StaticResource VisibleIf}}"/>
         <TextBlock Text="{Binding ChannelNote}" FontSize="11" Foreground="{StaticResource Muted}" Visibility="{Binding ShowChannelNote, Converter={StaticResource VisibleIf}}"/>
         <StackPanel Visibility="{Binding ShowEnvironment, Converter={StaticResource VisibleIf}}">
          <TextBlock Text="{Binding EnvironmentSummary}" Foreground="{Binding EnvironmentColour}" FontSize="11" FontWeight="SemiBold" ToolTip="{Binding EnvironmentDetail}"/>
          <ItemsControl ItemsSource="{Binding EnvironmentComponents}" Margin="0,5,0,0">
           <ItemsControl.ItemTemplate><DataTemplate>
            <Grid Margin="0,2,0,0" ToolTip="{Binding Detail}">
             <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
             <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,10,0"/>
             <TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="11" TextAlignment="Right"/>
            </Grid>
           </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
         </StackPanel>
        </StackPanel>
        <Border Grid.Row="5" MinHeight="16"/>
        <Grid Grid.Row="6">
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <Button Content="{Binding InstallText}" ToolTip="{Binding DetailNote}" Style="{StaticResource Primary}" Background="{Binding Theme.Primary}" BorderBrush="{Binding Theme.Primary}" Click="InstallClick" IsEnabled="{Binding CanInstall}" Visibility="{Binding ShowPrimary, Converter={StaticResource VisibleIf}}"/>
         <Button Content="{Binding LaunchText}" Foreground="{Binding Theme.Primary}" BorderBrush="{Binding Theme.Border}" Click="LaunchClick" IsEnabled="{Binding CanLaunch}">
          <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
           <Setter Property="Grid.Column" Value="2"/>
           <Style.Triggers><DataTrigger Binding="{Binding ShowPrimary}" Value="False">
            <Setter Property="Grid.Column" Value="0"/><Setter Property="Grid.ColumnSpan" Value="3"/>
           </DataTrigger></Style.Triggers>
          </Style></Button.Style>
         </Button>
        </Grid>
        <StackPanel Grid.Row="7" Margin="0,8,0,0">
         <Grid Visibility="{Binding Busy, Converter={StaticResource VisibleIf}}" Margin="0,8,0,4">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <ProgressBar Height="5" Value="{Binding Progress}" IsIndeterminate="{Binding InstallerRunning}" VerticalAlignment="Center" Foreground="{Binding Theme.Primary}"/>
          <Button Grid.Column="1" Content="Cancel" Style="{StaticResource Link}" Margin="12,0,0,0" Click="CancelClick" Visibility="{Binding CanCancel, Converter={StaticResource VisibleIf}}"/>
         </Grid>
         <TextBlock Text="{Binding Activity}" Foreground="#426779" FontSize="11" Margin="0,2,0,4">
          <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
           <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
          </Style></TextBlock.Style>
         </TextBlock>
        </StackPanel>
       </Grid>
       <StackPanel Visibility="{Binding ShowCompact, Converter={StaticResource VisibleIf}}" VerticalAlignment="Center" Margin="12,12">
        <Image Source="{Binding Icon}" Width="96" Height="96" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="{Binding Name}"/>
        <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" TextAlignment="Center" Margin="0,14,0,0"/>
        <ComboBox Width="150" ItemsSource="{Binding Channels}" SelectedItem="{Binding Channel}" IsEnabled="{Binding CanChoose}" HorizontalAlignment="Center" Margin="0,16,0,12"
         AutomationProperties.Name="Release channel" ToolTip="Choose the release channel to install."/>
        <Button Content="Install" Style="{StaticResource Primary}" Background="{Binding Theme.Primary}" BorderBrush="{Binding Theme.Primary}" Click="InstallClick" IsEnabled="{Binding CanInstall}"/>
        <StackPanel Visibility="{Binding ShowNetworkDiscovery, Converter={StaticResource VisibleIf}}" Margin="0,8,0,0">
         <ItemsControl ItemsSource="{Binding NetworkConfigurators}">
          <ItemsControl.ItemTemplate><DataTemplate>
           <Button Content="{Binding LinkText}" ToolTip="{Binding Address}" Style="{StaticResource Link}" Click="OpenNetworkConfiguratorClick" HorizontalAlignment="Center" Margin="0,4,0,0"/>
          </DataTemplate></ItemsControl.ItemTemplate>
         </ItemsControl>
         <TextBlock Text="{Binding NetworkDiscoveryStatus}" FontSize="11" Foreground="{StaticResource Muted}" TextAlignment="Center" Margin="0,4,0,0"/>
        </StackPanel>
        <Grid Visibility="{Binding Busy, Converter={StaticResource VisibleIf}}" Margin="0,12,0,0">
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <ProgressBar Height="5" Value="{Binding Progress}" IsIndeterminate="{Binding InstallerRunning}" VerticalAlignment="Center" Foreground="{Binding Theme.Primary}"/>
         <Button Grid.Column="1" Content="Cancel" Style="{StaticResource Link}" Margin="12,0,0,0" Click="CancelClick" Visibility="{Binding CanCancel, Converter={StaticResource VisibleIf}}"/>
        </Grid>
        <TextBlock Text="{Binding Activity}" Foreground="#426779" FontSize="11" Margin="0,8,0,0" TextAlignment="Center">
         <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
          <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
         </Style></TextBlock.Style>
        </TextBlock>
       </StackPanel>
       </Grid>
      </Border>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
   </StackPanel>
  </ScrollViewer>
  <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Background="#FCFDFE" Padding="28,9">
   <StackPanel>
    <TextBlock Text="© 2026 John Lightfoot · Proprietary · Free for non-commercial use." FontSize="11" Foreground="{StaticResource Muted}"
     ToolTip="Copyright © 2026 John Lightfoot. All rights reserved. Commercial use requires a separate written licence. See LICENSE.md for the full terms."/>
    <TextBlock Text="{Binding Footer}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,5,0,0">
     <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
     </Style></TextBlock.Style>
    </TextBlock>
   </StackPanel>
  </Border>
 </Grid>
</Window>
