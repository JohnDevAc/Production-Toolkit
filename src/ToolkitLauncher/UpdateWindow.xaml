<Window x:Class="ToolkitLauncher.UpdateWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Production Toolkit update" Width="540" SizeToContent="Height"
 ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="Assets/toolkit.ico"
 Background="#F3F6F8" FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <Border Background="#F3F6F8" Padding="28"><Grid TextElement.Foreground="#1C2A3A">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="An update is available" FontSize="23" FontWeight="SemiBold"/>
  <TextBlock Grid.Row="1" Text="{Binding VersionText}" Margin="0,14,0,0" FontWeight="SemiBold"/>
  <TextBlock Grid.Row="2" Text="Update Production Toolkit now? The installer will close the app, replace it and reopen it. Your settings will be kept." Foreground="{StaticResource Muted}" Margin="0,12,0,0" LineHeight="20"/>
  <ProgressBar Grid.Row="3" Value="{Binding Progress, Mode=OneWay}" Height="6" Margin="0,20,0,0" Foreground="#234D66" Visibility="{Binding Busy, Converter={StaticResource VisibleIf}}"/>
  <TextBlock Grid.Row="4" Text="{Binding Activity}" Margin="0,12,0,0" Foreground="{StaticResource Muted}">
   <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style>
  </TextBlock>
  <Grid Grid.Row="5" Margin="0,24,0,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Button Content="Update and restart" Style="{StaticResource Primary}" IsEnabled="{Binding CanUpdate}" Click="UpdateClick" IsDefault="True"/>
   <Button Grid.Column="2" Content="{Binding CancelText}" Click="CancelClick" IsCancel="False"/>
  </Grid>
 </Grid></Border>
</Window>
